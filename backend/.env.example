# AI Data Analyst - Environment Variables
# Copy this file to .env and fill in your values

# ======================
# Application Settings
# ======================
APP_NAME="AI Data Analyst"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ======================
# Server Settings
# ======================
HOST=0.0.0.0
PORT=8000

# ======================
# CORS Settings
# ======================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================
# File Upload Settings
# ======================
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_FILE_SIZE_MB=200
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ======================
# Database
# ======================
DATABASE_URL=sqlite:///./ai_data_analyst.db

# ======================
# AI / LLM Settings (Optional)
# ======================
# Get your free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ======================
# Security
# ======================
SECRET_KEY=your_super_secret_key_change_in_production_please
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================
# Performance
# ======================
MAX_ROWS_FOR_ML=500000
CACHE_TTL_SECONDS=3600
BACKGROUND_WORKERS=4
# ======================
# SMTP Email Settings (required for OTP verification emails)
# ======================
# Gmail example (enable 2-Step Verification, then create an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-gmail@gmail.com
# Use the 16-character App Password (NOT your normal Gmail password):
SMTP_PASSWORD=your_16_char_app_password
# Users see the email come from this address:
SMTP_FROM=your-app-gmail@gmail.com
SMTP_FROM_NAME=AI Data Analyst
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Local dev alternative (MailHog): host=localhost, port=1025, TLS=false

# ======================
# OTP Email Verification (registration)
# ======================
# When true, new registrations must enter a 6-digit code emailed to them
# before the account is activated. Login remains email + password only.
OTP_ENABLED=True
OTP_CODE_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# AUTO_VERIFY_USERS must be False for OTP to be enforced:
AUTO_VERIFY_USERS=False
